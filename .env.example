# PolyStoreX Customer WebApp — environment template
#
# Local:  cp .env.example .env   then fill secrets in .env (never commit it).
# Production: set the same keys on the host (Vercel or DigitalOcean).
# Do not put real keys, tokens, or passwords in this file.
#
# Anything prefixed NEXT_PUBLIC_ is embedded in the browser bundle.
# Server-only secrets must NOT use the NEXT_PUBLIC_ prefix.

NEXT_PUBLIC_APP_NAME=PolyStoreX Customer Portal

# Canonical site URL used for SEO. Use http://localhost:3001 for local dev.
# Production target: https://customer.polystorex.com
# Current deploy until DNS cutover: https://swaroop-customer-webapp.vercel.app
NEXT_PUBLIC_APP_URL=https://swaroop-customer-webapp.vercel.app
NEXT_PUBLIC_APP_ENV=production

# Public API. Production builds must call the deployed API, not localhost.
NEXT_PUBLIC_API_BASE_URL=https://swaroop-backend-xzwkz.ondigitalocean.app/api/v1
# After DNS, TLS, and CORS are verified:
# NEXT_PUBLIC_API_BASE_URL=https://api.polystorex.com/api/v1
NEXT_PUBLIC_API_TIMEOUT=30000

# Local dev only. The deployed API rejects browser CORS from localhost, so
# point the client at /api/v1 and let Next proxy to the backend.
# Leave API_PROXY_TARGET unset in production.
# API_PROXY_TARGET=https://swaroop-backend-xzwkz.ondigitalocean.app
# NEXT_PUBLIC_API_BASE_URL=/api/v1
# NEXT_PUBLIC_CX_API_URL=

NEXT_PUBLIC_CX_API_URL=https://swaroop-backend-xzwkz.ondigitalocean.app
NEXT_PUBLIC_ADMIN_API_URL=https://admin.polystorex.com

NEXT_PUBLIC_AUTH_COOKIE_NAME=pt_customer_token
NEXT_PUBLIC_REFRESH_TOKEN_KEY=pt_customer_refresh
NEXT_PUBLIC_ENABLE_AUTH_GUARD=true
NEXT_PUBLIC_ENABLE_ANALYTICS=false
NEXT_PUBLIC_ENABLE_WEBSOCKETS=false
NEXT_PUBLIC_ENABLE_PAYMENTS=false

# Demo OTP hints. Must stay false in production.
NEXT_PUBLIC_DEMO_OTP=false

# Browser key for the address-confirmation map (Maps JavaScript API only).
# Restrict the key by HTTP referrer to your domains. Leave empty to hide the map.
# Address search and reverse geocoding go through the backend. Never put a
# server Maps key, Places key, or unrestricted key here.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
