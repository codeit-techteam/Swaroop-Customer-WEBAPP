# Application
NEXT_PUBLIC_APP_NAME=PetroTrade Customer Portal
NEXT_PUBLIC_APP_URL=http://localhost:3001
NEXT_PUBLIC_APP_ENV=production

# DigitalOcean App Platform backend
NEXT_PUBLIC_API_BASE_URL=https://swaroop-backend-xzwkz.ondigitalocean.app/api/v1
NEXT_PUBLIC_API_TIMEOUT=30000

# Auth
NEXT_PUBLIC_AUTH_COOKIE_NAME=pt_customer_token
NEXT_PUBLIC_ENABLE_AUTH_GUARD=true

# Feature flags
NEXT_PUBLIC_ENABLE_ANALYTICS=false
NEXT_PUBLIC_CX_API_URL=https://swaroop-backend-xzwkz.ondigitalocean.app
NEXT_PUBLIC_ADMIN_API_URL=http://localhost:3002
NEXT_PUBLIC_ENABLE_WEBSOCKETS=false
NEXT_PUBLIC_ENABLE_PAYMENTS=false

# Optional
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
