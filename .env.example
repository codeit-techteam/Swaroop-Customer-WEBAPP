NEXT_PUBLIC_APP_NAME=PetroTrade Customer Portal
# Production (Vercel): https://swaroop-customer-webapp.vercel.app
NEXT_PUBLIC_APP_URL=https://swaroop-customer-webapp.vercel.app
NEXT_PUBLIC_APP_ENV=production
# DigitalOcean App Platform backend (shared by Customer / Seller / Admin / Mobile)
NEXT_PUBLIC_API_BASE_URL=https://swaroop-backend-xzwkz.ondigitalocean.app/api/v1
# Local dev against the deployed backend (it rejects CORS from localhost):
#   API_PROXY_TARGET=https://swaroop-backend-xzwkz.ondigitalocean.app
#   NEXT_PUBLIC_API_BASE_URL=/api/v1
#   NEXT_PUBLIC_CX_API_URL=
NEXT_PUBLIC_API_TIMEOUT=30000
NEXT_PUBLIC_AUTH_COOKIE_NAME=pt_customer_token
NEXT_PUBLIC_ENABLE_AUTH_GUARD=true
NEXT_PUBLIC_CX_API_URL=https://swaroop-backend-xzwkz.ondigitalocean.app
NEXT_PUBLIC_ADMIN_API_URL=https://swaroop-admin-pi.vercel.app
NEXT_PUBLIC_ENABLE_WEBSOCKETS=false
NEXT_PUBLIC_ENABLE_PAYMENTS=false
# Browser key for the address-confirmation map ONLY (Maps JavaScript API).
# Restrict by HTTP referrer to your web domains and to the Maps JavaScript API.
# Address search / reverse geocoding go through the backend (server key) —
# never enable Places/Geocoding on this key. Leave empty to hide the map.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
