# Application
NEXT_PUBLIC_APP_NAME=PetroTrade Customer Portal
NEXT_PUBLIC_APP_URL=http://localhost:3001
NEXT_PUBLIC_APP_ENV=development

# Same Swaroop-Backend the Customer mobile APP uses (default PORT=3000).
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000/api/v1
NEXT_PUBLIC_API_TIMEOUT=30000

# Auth placeholders (future JWT / RBAC)
NEXT_PUBLIC_AUTH_COOKIE_NAME=pt_customer_token
NEXT_PUBLIC_ENABLE_AUTH_GUARD=true

# Seller + ADMIN published marketplace feed
NEXT_PUBLIC_CX_API_URL=http://localhost:3000
NEXT_PUBLIC_ADMIN_API_URL=http://localhost:3002
NEXT_PUBLIC_ENABLE_WEBSOCKETS=false
NEXT_PUBLIC_ENABLE_PAYMENTS=false

# Optional — checkout / header “Use current location” reverse geocode (OSM used if empty)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
